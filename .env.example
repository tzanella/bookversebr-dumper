# Credenciais da API Telegram MTProto (obtenha em https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Número de telefone da conta do Telegram com DDI e DDD (ex: +5511999999999)
TELEGRAM_PHONE=

# Arquivo para persistência da sessão do Telegram
SESSION_FILE=./session.txt

# ID numérico ou @username do canal/grupo fonte (onde estão os arquivos .epub)
# Exemplo: -1001234567890
SOURCE_GROUP_ID=

# ID numérico ou @username do grupo privado de destino (para onde serão reenviados)
# Exemplo: -1009876543210
DEST_GROUP_ID=

# Caminho do banco de dados SQLite local
DATABASE_PATH=./books.db

# Diretório para download local dos arquivos .epub
DOWNLOAD_DIR=./downloads

# Intervalo em milissegundos entre consultas à API OpenLibrary (evita bloqueios por rate limit)
REQUEST_DELAY_MS=1500
